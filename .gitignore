# Secrets and per-environment values
.env

# Generated SSH private keys. Terraform writes keys/ at 0700 and the key at 0600.
# The whole directory is ignored, plus the extensions in case one lands elsewhere.
keys/
*.pem
*.key
*.tfvars
!*.tfvars.example
*.auto.tfvars

# Holds the remediation webhook URL including its shared token. Alertmanager
# reads it at notify time via url_file, so the token never enters a committed
# config. Written by: make configure URL=...
monitoring/alertmanager/webhook_url
# Grafana Cloud remote_write credential. Prometheus does not expand environment
# variables in prometheus.yml, so basic_auth reads it from this file instead.
# Written by: make cloud-token TOKEN=glc_...
monitoring/prometheus/grafana_cloud_token

# Terraform state. bootstrap/ keeps LOCAL state, so it must never be committed.
*.tfstate
*.tfstate.*
.terraform/
crash.log
crash.*.log
tfplan
tfplan.*
*.tfplan

# Lambda zip Terraform builds from infra/modules/remediation/lambda
infra/modules/*/build/
*.zip

# Runtime output from the lab.
#
# chaos/incident.json and the rca reports are deliberately NOT ignored. A sample
# incident window and the RCA report it produced are deliverables, and they are
# the evidence behind the timestamps in the runbook. They get overwritten on the
# next run, which is expected.
monitoring/data/
chaos/incident.json.tmp.*

# Python
__pycache__/
*.pyc
.venv/

# macOS
.DS_Store
