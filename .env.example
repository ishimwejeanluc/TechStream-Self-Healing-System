# Copy to .env and edit. .env is gitignored.
#   cp .env.example .env
#
# Read automatically by docker compose from the repo root.

# Grafana admin login. The stack refuses to start if the password is unset,
# rather than silently defaulting to admin/admin on a public port.
# Generate one with: openssl rand -base64 24
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# App tuning
APP_NAME=techstream-web
BASE_LATENCY_MS=25

# Shared secret Alertmanager appends as ?token= when calling remediation.
# Must match remediation_webhook_token in infra/stack/terraform.tfvars, and the
# token in monitoring/alertmanager/webhook_url.
# Generate one with: openssl rand -hex 32
REMEDIATION_WEBHOOK_TOKEN=

# Best-effort throttle between remediation actions, in seconds. Alertmanager
# repeat_interval is the real guard against restart storms.
MIN_SECONDS_BETWEEN_ACTIONS=120
